{
	"name": "open-canasta",
	"version": "0.1.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"description": "Four-player partnership canasta in the browser, peer to peer: public trackers for the first contact, WebRTC for the game and the call.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"bot": "node --env-file-if-exists=.env --import tsx src/bot/cli.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@openrouter/agent": "0.11.0",
		"@trystero-p2p/torrent": "0.26.0",
		"werift": "0.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.64.1",
		"@types/node": "22.20.5",
		"@vitest/browser-playwright": "5.0.5",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
